{
  "name": "@haidra-org/horde-design-system",
  "version": "0.1.0",
  "description": "Shared design tokens and CSS primitives for Haidra-Org frontends",
  "peerDependencies": {
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0",
    "tailwindcss": "^4.0.0"
  },
  "files": [
    "tokens/",
    "primitives/",
    "components/"
  ],
  "prettier": {
    "tabWidth": 2,
    "printWidth": 80,
    "trailingComma": "all",
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css"
  }
}
